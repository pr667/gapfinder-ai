# --- Required -----------------------------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Postgres connection string (Neon). Vercel adds this automatically when you
# attach a Neon database from the Storage tab. Leave empty for local dev and
# the app uses an embedded Postgres (PGlite) stored in ./.data
DATABASE_URL=

# --- Optional -----------------------------------------------------------
# Main model: topic map, question writing, grading, explanations
GROQ_MODEL=openai/gpt-oss-120b
# Lighter model: past-paper mapping, gap diagnosis, plan tips
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Hybrid retrieval: set an embeddings key to add semantic search on top of
# BM25. Any OpenAI-compatible embeddings endpoint works; the defaults target
# Google's free Gemini endpoint (key from https://aistudio.google.com/apikey).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
